<?xml version="1.0" encoding="utf-8"?>
<!--
  Copied into dist/ by webpack (see webpack.config.js CopyWebpackPlugin), so
  it always lands at the IIS site ROOT alongside taskpane.html on every
  `npm run build`. Do not place a copy inside backend/ instead — IIS only
  reads routing config (handlers, rewrite rules, iisnode settings) starting
  from the site root's web.config, so a copy nested in a subfolder cannot
  intercept requests like /api/health at the root.

  Expects a "backend" subfolder (server.js, package.json, node_modules)
  alongside this file, deployed separately from the dist/ build output.
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="backend/server.js" verb="*" modules="iisnode" />
    </handlers>

    <rewrite>
      <rules>
        <rule name="MentionNotifierApi" stopProcessing="true">
          <match url="^api/.*" />
          <action type="Rewrite" url="backend/server.js" />
        </rule>
      </rules>
    </rewrite>

    <iisnode
      nodeProcessCommandLine="&quot;C:\Program Files\nodejs\node.exe&quot;"
      watchedFiles="backend/web.config;backend/*.js"
      loggingEnabled="true"
      logDirectory="iisnode"
      maxLogFileSizeInKB="1024"
      maxTotalLogFileSizeInKB="20480"
      maxLogFiles="40"
      devErrorsEnabled="false"
    />

    <!--
      Without this, IIS substitutes its own generic HTML error page over any
      error-range response our Express app returns (e.g. our JSON 502 body),
      which is why failures showed up in the browser as an opaque HTML 502
      instead of the actual { error: "..." } payload from server.js.
    -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
